---
import { plans } from '../data/planes';
---

<header class="border-b border-gray-200 sticky top-0 bg-white/90 backdrop-blur z-40">
  <div class="max-w-6xl mx-auto flex items-center justify-between px-6 py-4">
    <a href="/" class="text-xl font-bold">LeoBringasAtLife</a>
    <nav class="hidden md:flex items-center gap-8 text-base font-semibold p-2" aria-label="Principal">
      <a href="#planes" class="text-[#3C3C3C] px-4 py-2 hover:text-black hover:underline underline-offset-4">Planes</a>
      <a href="#proceso" class="text-[#3C3C3C] px-4 py-2 hover:text-black hover:underline underline-offset-4">Proceso</a>
      <a href="#proyectos" class="text-[#3C3C3C] px-4 py-2 hover:text-black hover:underline underline-offset-4">Proyectos</a>
      <a href="#contacto" class="text-[#3C3C3C] px-4 py-2 hover:text-black hover:underline underline-offset-4">Contacto</a>
    </nav>
    <a
      href="https://wa.me/5491125417299?text=Hola%20Leonardo%2C%20quiero%20consultar%20por%20un%20sitio%20web."
      target="_blank"
      rel="noopener noreferrer"
      data-event="wa_click"
      data-place="header"
      class="pressable hidden md:block px-5 py-2 text-sm font-medium border border-black text-white bg-black rounded-[2rem]"
      >Empieza tu sitio web</a
    >
    <button id="menuToggle" aria-label="Abrir menú" aria-expanded="false" class="md:hidden p-2">
      <svg fill="none" stroke="currentColor" class="w-6 h-6" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" /></svg>
    </button>
  </div>
  <div id="mobileMenu" class="fixed inset-y-0 right-0 w-64 bg-white shadow-xl translate-x-full md:hidden z-50 transition-transform duration-200">
    <div class="p-6">
      <button id="menuClose" aria-label="Cerrar menú" class="absolute top-4 right-4 p-2">✕</button>
      <nav class="mt-8 flex flex-col gap-2 text-base">
        <a href="#planes" class="py-2 text-gray-500">Planes</a>
        <a href="#proceso" class="py-2 text-gray-500">Proceso</a>
        <a href="#proyectos" class="py-2 text-gray-500">Proyectos</a>
        <a href="#contacto" class="py-2 text-gray-500">Contacto</a>
      </nav>
    </div>
  </div>
  <div id="menuOverlay" class="fixed inset-0 bg-black/30 hidden md:hidden z-40"></div>
</header>

<script>
  const t = document.getElementById('menuToggle');
  const c = document.getElementById('menuClose');
  const m = document.getElementById('mobileMenu');
  const o = document.getElementById('menuOverlay');
  const open = () => {
    m?.classList.remove('translate-x-full');
    o?.classList.remove('hidden');
    t?.setAttribute('aria-expanded', 'true');
  };
  const close = () => {
    m?.classList.add('translate-x-full');
    o?.classList.add('hidden');
    t?.setAttribute('aria-expanded', 'false');
  };
  t?.addEventListener('click', open);
  c?.addEventListener('click', close);
  o?.addEventListener('click', close);
  document.addEventListener('keydown', (e) => e.key === 'Escape' && close());
</script>
