---
import Base from '../layouts/Base.astro';
---

<Base title="404 — Página no encontrada" description="La página que buscás no existe." path="/404">
  <main class="max-w-xl mx-auto px-6 py-32 text-center">
    <h1 class="text-5xl font-bold mb-4">404</h1>
    <p class="text-gray-600 mb-8">Esa página no existe. Volvé al inicio.</p>
    <a href="/" class="px-6 py-3 bg-black text-white rounded-full">Ir al inicio</a>
  </main>
</Base>
