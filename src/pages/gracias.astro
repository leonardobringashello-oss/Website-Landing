---
import Base from '../layouts/Base.astro';
---

<Base title="¡Gracias por tu consulta!" description="Te responderé en menos de 24 horas." path="/gracias">
  <main class="max-w-xl mx-auto px-6 py-32 text-center">
    <h1 class="text-4xl font-bold mb-4">¡Gracias!</h1>
    <p class="text-gray-600 mb-8">Te responderé en menos de 24 horas, de lunes a viernes.</p>
    <a href="/" class="px-6 py-3 bg-black text-white rounded-full">Volver</a>
  </main>
</Base>
